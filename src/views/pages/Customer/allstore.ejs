<link rel="stylesheet" href="css/customercss/storenearcustomer.css">
<div class="storesectionContainer">
    <!-- time function -->
     <%
    function formatTime12h(timeStr) {
        if (!timeStr) return "";
        const [hour, minute] = timeStr.split(":").map(Number);
        const h = hour % 12 || 12;
        const ampm = hour < 12 ? "AM" : "PM";
        return `${h}:${minute.toString().padStart(2, '0')} ${ampm}`;
    }
    function isOpen(opening, closing) {
        const now = new Date();

        // convert current UTC time to GCC minutes
        const nowHM = (now.getUTCHours() + 3) % 24 * 60 + now.getUTCMinutes();

        const [oH, oM] = opening.split(":").map(Number);
        const [cH, cM] = closing.split(":").map(Number);

        const openHM = oH * 60 + oM;
        const closeHM = cH * 60 + cM;

        if (openHM <= closeHM) {
            return (nowHM >= openHM && nowHM <= closeHM) ? "Open" : "Close";
        } else {
            return (nowHM >= openHM || nowHM <= closeHM) ? "Open" : "Close";
        }
    }
    %>
    <% if(subscribedStore.length>0 || stores.length>0) { %>
        <h1>Stores in Your Area</h1>
    <% } %>
    <% if(error){ %>
        <p><%= error %></p>
    <% } %>
   
    <br>
