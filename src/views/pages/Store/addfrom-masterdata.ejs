<link rel="stylesheet" href="/css/store/addfrom-masterdata.css" />

<div class="allproductcontainer">

  <h1>Master Store</h1>

  <% if (success_msg != '') { %>
    <div style="background-color: green !important" class="errorContainer">
      <p style="color: #fff"><%= success_msg %></p>
      <div class="crossError">
        <i class="fa-solid fa-xmark"></i>
      </div>
    </div>
  <% } %>

  <% if (error_msg != '') { %>
    <div style="background-color: red !important" class="errorContainer">
      <p style="color: #fff"><%= error_msg %></p>
      <div class="crossError">
        <i class="fa-solid fa-xmark"></i>
      </div>
    </div>
  <% } %>


  <!-- =========================================
       PRODUCT SEARCH
  ========================================== -->

  <div class="searchbarcontainer">

    <form action="/master-products" method="GET">

      <div class="master-search-wrapper">

        <input
          id="searchproduct"
          type="text"
          name="searchproducts"
          value="<%= search || '' %>"
          placeholder="Select or search product..."
          autocomplete="off"
        />

        <button type="submit" title="Search">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <!-- Custom Product Dropdown -->
        <div id="masterProductDropdown" class="master-product-dropdown">

          <% if (productSearchOptions && productSearchOptions.length > 0) { %>

            <% productSearchOptions.forEach(p => { %>

              <div
                class="master-product-option"
                data-product-name="<%= p.productname %>"
              >

                <div class="master-option-image">

                  <img
                    src="<%= p.productimage || '/images/no-image.png' %>"
                    alt="<%= p.productname %>"
                  />

                </div>

                <div class="master-option-info">

                  <h4>
                    <%= p.productname %>
                  </h4>

                  <% if (p.subcategory) { %>
                    <span>
                      <%= p.subcategory %>
                    </span>
                  <% } %>

                  <div class="master-option-price">

                    <% if (p.productofferprice) { %>

                      <del>
                        <%= p.productprice %>
                        <%= p.currency || '' %>
                      </del>

                      <strong>
                        <%= p.productofferprice %>
                        <%= p.currency || '' %>
                      </strong>

                    <% } else { %>

                      <strong>
                        <%= p.productprice %>
                        <%= p.currency || '' %>
                      </strong>

                    <% } %>

                  </div>

                </div>

              </div>

            <% }) %>

          <% } else { %>

            <div class="master-no-product">
              No master product found.
            </div>

          <% } %>

        </div>

      </div>

    </form>

  </div>


  <!-- =========================================
       CATEGORY FILTER
  ========================================== -->

  <% if (categoryCounts && categoryCounts.length > 0) { %>

    <div class="showmastercatoegory">

      <span class="showsubcategoryoption">
        Show Categories
        <i class="fa-solid fa-sort"></i>
      </span>

      <div class="subcategories">

        <!-- ALL -->

        <div>

          <p class="filterOption <%= !activeUrl ? 'active' : '' %>">

            <a href="/master-products">
              All
            </a>

            <span></span>

          </p>

        </div>


        <!-- CATEGORIES -->

        <% categoryCounts.forEach(items => { %>

          <div>

            <a
              href="/master-products?subcategory=<%= encodeURIComponent(items._id) %>"
              class="filterOption <%= activeUrl == items._id ? 'active' : '' %>"
            >

              <%= items._id %>

              <span>
                (<%= items.count %>)
              </span>

            </a>

          </div>

        <% }) %>

      </div>

    </div>

  <% } %>


  <!-- =========================================
       PRODUCTS
  ========================================== -->

  <div>

    <% if (products && products.length > 0) { %>

      <div class="allproducts">

        <% products.forEach(product => { %>

          <div class="productContainer">

            <!-- PRODUCT IMAGE -->

            <div class="productImage">

              <img
                src="<%= product.productimage %>"
                alt="<%= product.productname %>"
              />

            </div>


            <!-- PRODUCT NAME -->

            <h2 class="productname">
              <%= product.productname %>
            </h2>


            <!-- STORE ID -->

            <p class="store-id">
              Store Id: <%= product.store %>
            </p>


            <!-- SUBCATEGORY -->

            <p class="subcategory">
              Sub-cat: <%= product.subcategory %>
            </p>


            <!-- SKU -->

            <p class="subcategory">
              SKU: <%= product.sku %>
            </p>


            <!-- PRICE -->

            <% if (product.productofferprice) { %>

              <p class="productPrice">

                Regular:

                <span class="regularPrice">

                  <%= product.productprice %>
                  <%= product.currency %>

                </span>

              </p>

              <p class="productPrice">

                Offer Price:

                <%= product.productofferprice %>
                <%= product.currency %>

              </p>

            <% } else { %>

              <p class="productPrice">

                Regular:

                <%= product.productprice %>
                <%= product.currency %>

              </p>

            <% } %>


            <!-- ADD PRODUCT -->

            <div class="btnContainer">

              <form
                action="/master-products"
                method="POST"
                class="add-master-product-form"
              >

                <input
                  type="hidden"
                  name="productorigin"
                  value="<%= product._id %>"
                />

                <button
                  type="submit"
                  class="addproduct"
                >
                  Add to Store
                </button>

              </form>

            </div>

          </div>

        <% }) %>

      </div>


      <br />


      <!-- =========================================
           PAGINATION
      ========================================== -->

      <div class="pagination">

        <% if (currentPage > 1) { %>

          <a
            href="/master-products?page=<%= currentPage - 1 %><% if (activeUrl) { %>&subcategory=<%= encodeURIComponent(activeUrl) %><% } %><% if (search) { %>&searchproducts=<%= encodeURIComponent(search) %><% } %>"
          >
            Previous
          </a>

        <% } %>


        <span>
          Page <%= currentPage %> of <%= totalPages || 1 %>
        </span>


        <% if (currentPage < totalPages) { %>

          <a
            href="/master-products?page=<%= currentPage + 1 %><% if (activeUrl) { %>&subcategory=<%= encodeURIComponent(activeUrl) %><% } %><% if (search) { %>&searchproducts=<%= encodeURIComponent(search) %><% } %>"
          >
            Next
          </a>

        <% } %>

      </div>

      <br />


    <% } else { %>

      <div class="no-master-products">

        <i class="fa-solid fa-box-open"></i>

        <p>
          No Product from Master Data!
        </p>

      </div>

    <% } %>

  </div>

</div>


<script src="/js/storejs/add-from-masterdata.js"></script>